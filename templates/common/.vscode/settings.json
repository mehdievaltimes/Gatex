{
  "files.encoding": "utf8",
  "files.eol": "\n",
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 800,
  "workbench.editor.enablePreview": false,
  "workbench.startupEditor": "none",
  "breadcrumbs.enabled": false,
  "[latex]": {
    "editor.wordWrap": "on",
    "editor.minimap.enabled": false
  },
  "[bibtex]": {
    "editor.wordWrap": "on"
  },
  "search.exclude": {
    "**/build/**": true
  },
  "latex-workshop.latex.recipes": [
    {
      "name": "Build project (project.yml)",
      "tools": ["lwf"]
    }
  ],
  "latex-workshop.latex.tools": [
    {
      "name": "lwf",
      "command": "python3",
      "args": ["%WORKSPACE_FOLDER%/scripts/lwf.py", "build", "%DIR%"]
    }
  ],
  "latex-workshop.latex.recipe.default": "first",
  "latex-workshop.latex.build.enableMagicComments": true,
  "latex-workshop.latex.outDir": "%DIR%/build",
  "latex-workshop.latex.autoBuild.run": "onFileChange",
  "latex-workshop.latex.autoBuild.interval": 0,
  "latex-workshop.latex.autoBuild.cleanAndRetry.enabled": false,
  "latex-workshop.latex.autoClean.run": "never",
  "latex-workshop.showContextMenu": false,
  "latex-workshop.message.information.show": false,
  "latex-workshop.view.pdf.viewer": "tab",
  "latex-workshop.view.pdf.tab.editorGroup": "right",
  "latex-workshop.view.pdf.zoom": "page-width",
  "latex-workshop.view.pdf.reload.transition": "none",
  "latex-workshop.view.pdf.internal.synctex.keybinding": "double-click",
  "latex-workshop.synctex.afterBuild.enabled": true
}
