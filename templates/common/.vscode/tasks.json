{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build LaTeX project",
      "type": "process",
      "command": "python3",
      "args": ["${workspaceFolder}/scripts/lwf.py", "build", "${workspaceFolder}"],
      "options": {"cwd": "${workspaceFolder}"},
      "windows": {
        "command": "py",
        "args": ["-3", "${workspaceFolder}/scripts/lwf.py", "build", "${workspaceFolder}"]
      },
      "group": {"kind": "build", "isDefault": true},
      "problemMatcher": [],
      "presentation": {"reveal": "silent", "panel": "dedicated"}
    }
  ]
}
